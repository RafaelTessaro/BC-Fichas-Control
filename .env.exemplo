# Copie este arquivo para ".env" (na mesma pasta) para mudar as configurações do servidor.

# Porta usada no navegador: http://IP-DO-SERVIDOR:3000
PORTA=3000

# 0.0.0.0 = aceita conexões de todos os computadores da rede.
# Use 127.0.0.1 para permitir só o próprio servidor.
HOST=0.0.0.0

# Pasta onde ficam o banco de dados, os backups automáticos e a chave do Google Agenda.
# Pode ser um caminho absoluto, ex.: D:\BC-Fichas-Dados
PASTA_DADOS=dados
