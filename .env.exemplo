# Copie este arquivo para ".env" (na mesma pasta) para mudar as configurações do servidor.

# Porta usada no navegador: http://IP-DO-SERVIDOR:3000
PORTA=3000

# 0.0.0.0 = aceita conexões de todos os computadores da rede.
# Use 127.0.0.1 para permitir só o próprio servidor.
HOST=0.0.0.0

# Pasta onde ficam o banco de dados, os backups automáticos e a chave do Google Agenda.
# Pode ser um caminho absoluto, ex.: D:\BC-Fichas-Dados
PASTA_DADOS=dados

# Nomes pelos quais o sistema é aberto no navegador, além do IP, de "localhost" e do nome
# do computador (que sempre funcionam). Só precisa preencher se alguém acessa por um nome
# criado no roteador ou no DNS, ex.: http://bcfichas:3000 — separe vários com vírgula.
# Acesso por um nome que não está aqui é bloqueado (proteção contra sites maliciosos).
HOSTS_PERMITIDOS=
